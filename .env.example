# =====================================================================
# VOID — Vibe-Operated Intelligent Developer
# Environment Variables — copy this file to .env and fill in values
# =====================================================================

# ---- Required ----------------------------------------------------

# Anthropic / Claude API key  (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# JWT secret — generate with: openssl rand -hex 64
# REQUIRED in production; an ephemeral secret is used in development.
JWT_SECRET=

# ---- Google OAuth & Drive (optional, enables Drive sync) ---------

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match the redirect URI registered in Google Cloud Console
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# ---- Server config (optional, sensible defaults shown) -----------

PORT=3000
NODE_ENV=development
MARKETPLACE_PORT=3001

# ---- Gemini API key (optional, for Gemini model support) ---------
GEMINI_API_KEY=
